      "type": "array"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "quality_weight": {
      "default": 0.8,
      "title": "Quality Weight",
      "type": "number"
    },
    "request_headers": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Request Headers",
      "type": "object"
