      "type": "array"
    },
    "dataset_id": {
      "title": "Dataset Id",
      "type": "string"
    },
    "domain": {
      "title": "Domain",
      "type": "string"
    },
    "history": {
      "title": "History",
      "type": "string"
    },
    "licensing": {
      "title": "Licensing",
      "type": "string"
    },
