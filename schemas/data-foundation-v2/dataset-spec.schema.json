{
  "$defs": {
    "DatasetFieldSchema": {
      "description": "One canonical field in a Tier 1 dataset schema.",
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "dtype": {
          "enum": [
            "datetime",
            "float",
            "int",
            "str"
          ],
          "title": "Dtype",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "nullable": {
          "default": false,
          "title": "Nullable",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "dtype",
        "description"
      ],
      "title": "DatasetFieldSchema",
      "type": "object"
    }
  },
