{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "decision": {
      "enum": [
        "BUY",
        "SELL",
        "HOLD",
        "REDUCE",
        "INCREASE",
        "NO POSITION"
      ],
      "type": "string"
    },
    "execution": {
      "type": "object"
    },
    "portfolio_state": {
      "type": "object"
    },
    "timestamp": {
      "type": "string"
    }
  },
  "required": [
    "timestamp",
    "decision",
    "execution",
    "portfolio_state"
  ],
  "title": "Paper Trade Record",
  "type": "object"
}