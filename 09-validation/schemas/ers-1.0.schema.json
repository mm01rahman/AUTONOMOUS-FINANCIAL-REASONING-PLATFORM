{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "afrp:schemas:ers-1.0",
  "title": "AFRP Execution Evidence Schema (ERS-1.0)",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_id",
    "work_package_id",
    "capability",
    "agent_identity",
    "lifecycle",
    "boundary_compliance",
    "quality_gates",
    "artifacts",
    "unlocked_capabilities",
    "verdict"
  ],
  "properties": {
    "schema_version": { "const": "ERS-1.0" },
    "evidence_id": { "type": "string", "pattern": "^EXEC-[0-9]{3}$" },
    "work_package_id": { "type": "string", "pattern": "^WP-[A-Z]+-[0-9]{4}$" },
    "capability": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "agent_identity": {
      "type": "object",
      "required": ["role", "agent_vendor", "agent_name"],
      "properties": {
        "role": { "type": "string" },
        "agent_vendor": { "type": "string" },
        "agent_name": { "type": "string" }
      }
    },
    "lifecycle": {
      "type": "object",
      "required": ["protocol_version", "started_at", "finished_at", "final_state"],
      "properties": {
        "protocol_version": { "const": "EGP-2.0" },
        "started_at": { "type": "string" },
        "finished_at": { "type": "string" },
        "final_state": {
          "enum": [
            "EVIDENCE_GENERATED",
            "REVIEW_PENDING",
            "COMPLETED",
            "HALTED"
          ]
        },
        "state_transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["state", "at"],
            "properties": {
              "state": { "type": "string" },
              "at": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["predicate", "result"],
        "properties": {
          "predicate": { "type": "string" },
          "result": { "enum": ["PASS", "FAIL"] }
        }
      }
    },
    "boundary_compliance": {
      "type": "object",
      "required": ["bounded_files", "files_modified", "violations", "compliant"],
      "properties": {
        "bounded_files": { "type": "array", "items": { "type": "string" } },
        "files_modified": { "type": "array", "items": { "type": "string" } },
        "violations": { "type": "array", "items": { "type": "string" } },
        "compliant": { "type": "boolean" }
      }
    },
    "quality_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["gate", "command", "result"],
        "properties": {
          "gate": { "type": "string" },
          "command": { "type": "string" },
          "result": { "enum": ["PASS", "FAIL", "SKIPPED"] },
          "detail": { "type": "string" }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "required": ["source_files"],
      "properties": {
        "source_files": { "type": "array", "items": { "type": "string" } },
        "test_files": { "type": "array", "items": { "type": "string" } },
        "documentation": { "type": "array", "items": { "type": "string" } }
      }
    },
    "unlocked_capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version"],
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" }
        }
      }
    },
    "verdict": {
      "type": "object",
      "required": ["all_gates_passed", "boundary_compliant", "review_status"],
      "properties": {
        "all_gates_passed": { "type": "boolean" },
        "boundary_compliant": { "type": "boolean" },
        "review_status": {
          "enum": ["PENDING_ARB", "APPROVED", "REJECTED"]
        },
        "review_note": { "type": "string" }
      }
    }
  }
}
